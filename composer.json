{
    "name": "olorunda/laravel-zkteco-push",
    "description": "ZKTeco ADMS Push SDK Middleware & External REST API Interpreter Bridge for Laravel",
    "type": "library",
    "keywords": [
        "laravel",
        "zkteco",
        "adms",
        "push-sdk",
        "biometric",
        "attendance",
        "fingerprint",
        "face-recognition",
        "middleware"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "ZKTeco Push Team"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0",
        "illuminate/database": "^9.0|^10.0|^11.0|^12.0",
        "illuminate/http": "^9.0|^10.0|^11.0|^12.0",
        "illuminate/routing": "^9.0|^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "ZkTeco\\Push\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ZkTeco\\Push\\ZkTecoServiceProvider"
            ],
            "aliases": {
                "ZkTecoPush": "ZkTeco\\Push\\Facades\\ZkTecoPush"
            }
        }
    },
    "minimum-stability": "stable"
}
